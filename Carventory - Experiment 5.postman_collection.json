        "url": {
          "raw": "{{baseUrl}}/api/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "profile"]
        },
        "description": "Protected endpoint rejects expired JWT."
      }
    },
    {
      "name": "8. Multiple Requests / Rate Limit",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Rapid loop to trigger 429 Too Many Requests if executed in collection runner",
              "for (let i = 0; i < 110; i++) {",
              "    pm.sendRequest(pm.variables.get(\"baseUrl\") + \"/\", function (err, res) {});",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 429 Too Many Requests (or RateLimit header present)\", function () {",
              "    if (pm.response.code === 429) {",
              "        pm.response.to.have.status(429);",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.message).to.include(\"Too many requests\");",
              "    } else {",
              "        pm.expect(pm.response.headers.has(\"RateLimit-Limit\") || pm.response.headers.has(\"ratelimit-limit\") || pm.response.headers.has(\"Retry-After\")).to.be.true;",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Verifies rate limiting defense against DDoS / brute force."
      }
    },
    {
      "name": "9. Input Validation Failure",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"express-validator returns validation error list\", function () {",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.message).to.eql(\"Validation failed\");",
              "    pm.expect(jsonData.errors).to.be.an(\"array\");",
              "    pm.expect(jsonData.errors.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid-email-address\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Validates name, email format, and minimum 6 character password length."
      }

        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Maruti\",\n  \"model\": \"Swift\",\n  \"variant\": \"ZXI\",\n  \"year\": 2023,\n  \"price\": 725000,\n  \"kmDriven\": 15000,\n  \"fuel\": \"Petrol\",\n  \"transmission\": \"Manual\",\n  \"engine\": \"1197 cc\",\n  \"color\": \"Red\",\n  \"numberOfOwners\": 1,\n  \"location\": \"Ulhasnagar, Maharashtra\",\n  \"description\": \"Updated test car for Experiment 4.\",\n  \"photos\": [],\n  \"features\": [\n    \"Touchscreen\",\n    \"Rear Camera\",\n    \"Alloy Wheels\"\n  ],\n  \"status\": \"AVAILABLE\",\n  \"condition\": \"USED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cars/{{carId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cars", "{{carId}}"]
        },
        "description": "Update the price, description, and features of the created car."
      }
